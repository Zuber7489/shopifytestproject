    "faq_care": {
      "type": "collapsible-content",
      "blocks": {
        "faq_care_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I care for my vegetable-tanned leather bag?",
            "row_content": "<p>We recommend conditioning your bag twice a year with a natural beeswax leather balm. Wipe away dust with a dry microfiber cloth, avoid excessive prolonged water immersion, and allow natural marks to blend into a stunning vintage patina.</p>"
          }
        },
        "faq_care_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What makes Vala full-grain leather different?",
            "row_content": "<p>We never use split, bonded, or plastic-coated leathers. Full-grain preserves the outermost layer of the hide, retaining natural grain characteristics, unmatched tensile durability, and breathability.</p>"
          }
        },
        "faq_care_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How does the Lifetime Craft Guarantee work?",
            "row_content": "<p>If a strap anchor, rivet, zipper pull, or stitch gives way during normal usage, send it back to our atelier. Our craftsmen will repair or replace your item with genuine parts free of charge.</p>"
          }
        },
        "faq_care_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you offer complimentary monogramming?",
            "row_content": "<p>Yes. Complimentary hot-foil monogramming (gold, silver, or blind deboss) is available on all structured totes, cardholders, and duffle bags upon request during checkout.</p>"
          }
        }
      },
      "block_order": [
        "faq_care_1",
        "faq_care_2",
        "faq_care_3",
        "faq_care_4"
      ],
