    "craftsmanship_story": {
      "type": "image-with-text",
      "blocks": {
        "story_heading": {
          "type": "heading",
          "settings": {
            "heading": "Sculpted by Hand in Small Batches",
            "heading_size": "h1"
          }
        },
        "story_text": {
          "type": "text",
          "settings": {
            "text": "<p>In a world of mass production, Vala Atelier stands for deliberate patience. Over 48 hours of artisanal handwork go into each piece — from hand-selecting top-tier hide sections to edge burnishing with natural beeswax and assembling solid brass hardware.</p><p>Crafted to be carried every day, aging with grace and memories.</p>",
            "text_style": "body"
          }
        },
        "story_btn": {
          "type": "button",
          "settings": {
            "button_label": "Discover The Atelier Heritage",
            "button_link": "shopify://collections/all"
          }
        }
