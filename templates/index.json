            "link": "shopify://collections/all"
          }
        },
        "col_artisan": {
          "type": "column",
          "settings": {
            "title": "Master Saddle Stitching",
            "text": "<p>Every seam, burnished edge, and brass rivet is hand-finished by master leather artisans with generational heritage.</p>",
            "link_label": "Our Process",
            "link": "shopify://collections/all"
          }
        },
        "col_guarantee": {
          "type": "column",
          "settings": {
            "title": "Lifetime Craft Guarantee",
            "text": "<p>We build heirloom essentials. If stitching or hardware ever fails, our atelier repairs or replaces your bag for life.</p>",
            "link_label": "Warranty Terms",
            "link": "shopify://collections/all"
          }
