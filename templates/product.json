{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "trust_badges": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "leather",
            "heading_1": "Tuscan Full-Grain",
            "icon_2": "truck",
            "heading_2": "Express Delivery",
            "icon_3": "check_mark",
            "heading_3": "Lifetime Warranty"
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "leather_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Leather Origin & Craftsmanship",
            "icon": "leather",
            "content": "<p>Handcrafted from 100% full-grain vegetable-tanned Tuscan leather. Features solid hand-polished brass hardware, reinforced stress points, and edge-burnished waxed linen saddle stitching. Designed to age into a rich, distinctive vintage patina.</p>",
            "page": ""
          }
        },
        "dimensions_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions & Laptop Capacity",
            "icon": "ruler",
            "content": "<p><strong>Height:</strong> 11.5 in (29 cm)<br><strong>Width:</strong> 15.0 in (38 cm)<br><strong>Depth:</strong> 5.5 in (14 cm)<br><strong>Adjustable Shoulder Strap:</strong> 18 - 24 in (46 - 61 cm)<br><strong>Fit:</strong> Easily accommodates up to a 15\" laptop, tablet, wallet, keys, and daily essentials.</p>",
            "page": ""
          }
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Complimentary Shipping & Lifetime Warranty",
            "icon": "truck",
            "content": "<p><strong>Complimentary Shipping:</strong> Tracked, insured express delivery worldwide.<br><strong>30-Day Returns:</strong> Hassle-free exchanges or full refunds on non-personalized bags.<br><strong>Lifetime Craft Guarantee:</strong> If any seam, zipper pull, or hardware ever fails, our atelier repairs or replaces it free of charge.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share this piece"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_badges",
        "description",
        "leather_tab",
        "dimensions_tab",
        "shipping_tab",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "stacked",
        "media_position": "left",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You May Also Admire",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "background-1",
        "image_ratio": "portrait",
        "show_secondary_image": true,
        "show_vendor": true,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}
